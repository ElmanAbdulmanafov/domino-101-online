[Unit]
Description=Domino 101 Online Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/domino-101
ExecStart=/usr/bin/node /opt/domino-101/server.mjs
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=4173
User=ubuntu

[Install]
WantedBy=multi-user.target
